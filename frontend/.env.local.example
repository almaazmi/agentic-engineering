# Frontend runtime configuration (copy to .env.local for local dev)
#
# The browser calls the frontend's own /api/* routes, which are proxied
# server-side to the backend at BACKEND_URL. This is a *runtime* variable.
BACKEND_URL=http://localhost:8000

# Optional: only set this if you want the browser to call the backend directly
# instead of via the same-origin proxy (not recommended).
# NEXT_PUBLIC_API_BASE_URL=
